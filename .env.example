# Copy to .env and replace with your real Congress.gov API key.
# Register at https://api.congress.gov/
CONGRESS_API_KEY=your-api-key-here

# Optional: workspace root (default: .congressgov)
# CONGRESS_WORKSPACE=.congressgov

# Optional: override blob-lane backend (default: sqlite under workspace api/)
# CONGRESS_REQUEST_STORE=sqlite:///.congressgov/api/request_store.db
# CONGRESS_REQUEST_STORE=file:///.congressgov/api/request_store
# CONGRESS_REQUEST_STORE=redis://localhost:6379/0
